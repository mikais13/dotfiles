#!/usr/bin/env bash

# Prepare a new git worktree: copy untracked local files from the main
# checkout, then install dependencies.
# Usage: worktree-setup <main-checkout> <new-worktree> [--no-install]
# Files to copy are the gitignored files that match
# <main-checkout>/.worktreeinclude (gitignore syntax), or env files by default. All output goes to stderr, so hooks can keep
# stdout for their own result.
set -euo pipefail
exec 3>&1 1>&2

src=$(cd -- "$1" && pwd -P)
dst=$(cd -- "$2" && pwd -P)
install=1
[[ ${3:-} == --no-install ]] && install=0

if [[ -f $src/.worktreeinclude ]]; then
    patterns=$(<"$src/.worktreeinclude")
else
    patterns=$'.env*\n!.env.example'
fi

copied=0
while IFS= read -r -d '' file; do
    [[ $file == node_modules/* || $file == */node_modules/* || -e $dst/$file ]] && continue
    mkdir -p -- "$dst/$(dirname -- "$file")"
    # -c makes an APFS clone, so the copy costs no extra disk.
    cp -c -- "$src/$file" "$dst/$file"
    echo "[worktree] Copied: $file"
    copied=$((copied + 1))
done < <(
    # Only copy gitignored files, as Claude Code does. Untracked files that git
    # sees would make the worktree dirty and block `git worktree remove`.
    git -C "$src" ls-files -z --others --ignored --exclude-from=<(printf '%s\n' "$patterns") |
        git -C "$src" check-ignore -z --stdin || true
)
echo "[worktree] Copied $copied file(s) to $dst"

if ((install)) && [[ -f $dst/pnpm-lock.yaml ]]; then
    (cd -- "$dst" && pnpm install --frozen-lockfile --prefer-offline)
fi
