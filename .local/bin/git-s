#!/usr/bin/env bash
# Compact git status with diff sizes. Run as `git s`.
set -euo pipefail

git rev-parse --is-inside-work-tree >/dev/null

# Compare against the empty tree when the repo has no commits yet.
base=$(git rev-parse -q --verify HEAD || git hash-object -t tree /dev/null)

{
  git status --porcelain=v2 --branch --show-stash
  git diff --cached --numstat -z | tr '\0' '\n' | sed 's/^/C /'
  git diff --numstat -z | tr '\0' '\n' | sed 's/^/W /'
  git diff "$base" --numstat | sed 's/^/T /'
} | awk '
  # Drop the first n space-separated fields; the rest is the path (may hold spaces).
  function rest(line, n,   i) {
    for (i = 0; i < n; i++) sub(/^[^ ]* /, "", line)
    return line
  }
  function quote(s) { gsub(/\047/, "\047\\\047\047", s); return "\047" s "\047" }
  function stat(a, d) {
    if (a == "-") return "\033[2mbin\033[0m"
    return "\033[32m+" a "\033[0m \033[31m-" d "\033[0m"
  }
  function add(xy, path) {
    if (substr(xy, 1, 1) != ".") { sc[++s] = substr(xy, 1, 1); sp[s] = path }
    if (substr(xy, 2, 1) != ".") { uc[++u] = substr(xy, 2, 1); up[u] = path }
    width(path)
  }
  function width(p) { if (length(p) > w) w = length(p) }
  function header(color, name, k) {
    printf "\033[%sm%s\033[0m - %d file%s\n", color, name, k, (k == 1 ? "" : "s")
  }
  # numstat -z: "a<TAB>d<TAB>path", or "a<TAB>d<TAB>" then old and new path lines for a rename.
  function numstat(tag, line,   f) {
    if (pending[tag] == 2) { pending[tag] = 1; return }
    if (pending[tag] == 1) { pending[tag] = 0; size[tag, line] = ns[tag]; return }
    split(line, f, "\t")
    ns[tag] = f[1] SUBSEP f[2]
    if (f[3] == "") pending[tag] = 2
    else size[tag, f[3]] = ns[tag]
  }
  function show(tag, code, path,   key, f) {
    key = path; sub(/^.* -> /, "", key)
    if (!((tag, key) in size)) { printf fmt, code, path, ""; return }
    split(size[tag, key], f, SUBSEP)
    printf fmt, code, path, stat(f[1], f[2])
  }

  /^# branch.head/     { head = $3 }
  /^# branch.upstream/ { upstream = " \033[2m-> " $3 "\033[0m" }
  # Match the p10k prompt: <behind>ahead.
  /^# branch.ab/       {
    if ($4 != "-0") ab = "<" substr($4, 2)
    if ($3 != "+0") ab = ab ">" substr($3, 2)
    if (ab != "") ab = " " ab
  }
  /^# stash/           { stash = "  stash:" $3 }
  /^1 /                { add($2, rest($0, 8)) }
  /^2 /                { split(rest($0, 9), pp, "\t"); add($2, pp[2] " -> " pp[1]) }
  /^u /                { cp[++c] = rest($0, 10); width(cp[c]) }
  /^\? /               {
    p = rest($0, 1); np[++n] = p; width(p)
    if (p !~ /\/$/) {
      cmd = "git diff --no-index --numstat -- /dev/null " quote(p)
      if ((cmd | getline line) > 0) {
        split(line, f, "\t"); size["N", p] = f[1] SUBSEP f[2]
        if (f[1] != "-") { ta += f[1]; files++ }
      }
      close(cmd)
    }
  }
  /^[CW] /             { numstat(substr($0, 1, 1), substr($0, 3)) }
  /^T /                { split(substr($0, 3), f, "\t"); files++; if (f[1] != "-") { ta += f[1]; td += f[2] } }

  END {
    fmt = "  %s %-" w "s  %s\n"
    printf "\033[1m%s\033[0m%s%s%s\n\n", head, upstream, ab, stash
    if (c) { header("31", "conflicts", c); for (i = 1; i <= c; i++) printf fmt, "U", cp[i], "" }
    if (s) { header("32", "staged", s);    for (i = 1; i <= s; i++) show("C", sc[i], sp[i]) }
    if (u) { header("33", "changed", u);   for (i = 1; i <= u; i++) show("W", uc[i], up[i]) }
    if (n) { header("2", "untracked", n);  for (i = 1; i <= n; i++) show("N", "?", np[i]) }
    if (!s && !u && !n && !c) print "clean"
    else printf "\n\033[1mtotal\033[0m %d file%s  %s\n", files, (files == 1 ? "" : "s"), stat(ta, td)
  }'
